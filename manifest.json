{
  "manifest_version": 3,
  "name": "Domain Tabs · 域名标签管理",
  "description": "在侧栏按域名整理标签页，通过窗口 Tab 搜索、切换和管理不同浏览器窗口的标签。",
  "version": "1.0.17",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开域名标签侧栏",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "打开或关闭域名标签侧栏"
    },
    "focus-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "打开侧栏并聚焦标签搜索框"
    }
  }
}
